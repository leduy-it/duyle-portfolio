# Server-only. Configure these in Vercel Production and Preview, then redeploy.
# Never prefix a secret with NEXT_PUBLIC_. Never commit .env.local.
SITE_URL=
OPENROUTER_API_KEY=
# Optional free model override. See src/lib/chat/models.ts.
OPENROUTER_MODEL=

# Resend verified sender (e.g. Portfolio <hello@your-verified-domain>).
# The recipient stays levduyit@gmail.com in server code.
# Free email providers: Resend or Brevo. A verified sender and API key are required.
CONTACT_PROVIDER=resend
BREVO_API_KEY=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Owner login passphrase and a separate random signing secret (at least 32 chars).
# Passphrases are trimmed and case-insensitive. No public fallback is accepted.
ADMIN_PASSPHRASE=
ADMIN_SECRET=
# Stable random salt; when omitted, production derives a salt from ADMIN_SECRET.
TRACKING_SALT=

# Upstash Redis Marketplace integration. KV_REST_API_URL/TOKEN also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Jina query embeddings. No paid top-ups; lexical retrieval works without this.
JINA_API_KEY=
